{
  "target_user": "二本/普通本科在校生和应届生，缺实习、缺竞赛，想找技术岗",
  "sections": [
    {
      "name": "个人信息",
      "required": ["姓名", "电话", "邮箱"],
      "optional": ["GitHub", "个人网站", "求职意向"]
    },
    {
      "name": "教育背景",
      "required": ["学校", "专业", "时间"],
      "optional": ["GPA", "主修课程", "排名"]
    },
    {
      "name": "项目经历",
      "required": ["项目名", "时间", "你的角色", "技术栈", "做了什么", "结果"],
      "optional": ["项目链接", "团队规模"],
      "rules": [
        "用STAR法则：情境-任务-行动-结果",
        "每条不超过25字，动词开头，结果提前",
        "必须有量化数据，没有就标记[请填写真实数字]",
        "不要写'负责了''参与了'，直接写'负责''参与'"
      ]
    },
    {
      "name": "实习经历",
      "required": ["公司", "时间", "岗位", "做了什么", "结果"],
      "optional": ["团队规模", "汇报对象"],
      "rules": [
        "和项目经历同样的规则",
        "如果没有实习，写'暂无'，不要编造"
      ]
    },
    {
      "name": "技能证书",
      "required": ["技能名称", "掌握程度"],
      "rules": [
        "不要写'精通'，除非原文明确写了",
        "用'掌握''能独立完成''参与过'这种更可信的表达",
        "证书写全称，写清楚发证机构"
      ]
    },
    {
      "name": "自我评价",
      "required": [],
      "rules": [
        "删掉空话，保留具体、可信的描述",
        "不要写'学习能力强''能吃苦''有责任心'",
        "如果要写，必须跟具体经历挂钩"
      ]
    }
  ],
  "problems_to_check": [
    "缺少量化数据",
    "动词弱",
    "无目标岗位关键词",
    "格式混乱",
    "自我评价空泛",
    "技能描述不具体",
    "项目描述没有结果"
  ],
  "output_format": {
    "matchScore": "0-100的数字",
    "problems": "问题清单，每条包含title和detail",
    "suggestions": "逐条建议，每条包含problem和advice",
    "optimizedResume": "优化后的简历全文",
    "diff": "对比列表，每条包含original、optimized、reason"
  }
}